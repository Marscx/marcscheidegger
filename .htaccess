# =============================================================================
# marcscheidegger.ch – Regeln für den Webserver (Apache auf Plesk/Metanet)
# =============================================================================
# Diese Datei liest der Server bei jedem Aufruf. Sie gilt für diesen Ordner und
# alle Unterordner. Zeilen mit # sind Kommentare.
# Aufbau:
#   1. Grundeinstellungen (Startseite, Fehlerseite, Zeichensatz)
#   2. HTTPS erzwingen
#   3. Alte WordPress-Adressen auf die neuen Seiten umleiten
#   4. Liegengelassenes WordPress stilllegen
#   5. Caching (wie lange Browser Dateien zwischenspeichern)
#   6. Test-Subdomain vor Google verstecken, Sicherheits-Header
#
# Lesehilfe für die Umleitungen:
#   RewriteCond  = Bedingung ("wenn …")
#   RewriteRule  = Regel: Muster der Adresse → Ziel [Optionen]
#   R=301  dauerhafte Umleitung (Google übernimmt die neue Adresse)
#   L      letzte Regel, danach aufhören       F    verboten (Fehler 403)
#   QSD    Anhang "?p=…" weglassen             NE   "#" im Ziel nicht verändern
#   ^ … $  Anfang … Ende der Adresse

# ---------- 1. Grundeinstellungen ----------
# Welche Datei als Startseite eines Ordners gilt, in dieser Reihenfolge.
# Unterordner (moodle, MarcBuch, ghoerweg …) haben teils index.htm oder index.php als Startseite
DirectoryIndex index.html home.html index.htm index.php
# Eigene Fehlerseite "Falscher Ton." für unbekannte Adressen
ErrorDocument 404 /404.html
# Umlaute korrekt anzeigen
AddDefaultCharset utf-8

# <IfModule …> = nur ausführen, wenn der Server diese Funktion hat (verhindert Fehler)
<IfModule mod_rewrite.c>
RewriteEngine On

# ---------- 2. HTTPS erzwingen ----------
# Wer http://… aufruft, wird auf die verschlüsselte Adresse https://… umgeleitet.
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ---------- 3. Alte WordPress-Adressen umleiten ----------
# WordPress hatte Adressen wie marcscheidegger.ch/?p=65 (Beitrag), ?page_id=77 (Seite)
# und ?cat=17 (Kategorie = Jahr). Damit alte Links und Google-Treffer weiter
# funktionieren, führt jede alte Nummer zur passenden Stelle der neuen Website.
#   ?p=…        Beitrag einer Band   → projekte.html#band
#   ?page_id=…  WordPress-Seite      → passende neue Seite
#   ?cat=…      Jahres-Kategorie     → chronologie.html#jahr-JJJJ
RewriteCond %{QUERY_STRING} (^|&)p=33(&|$)
RewriteRule ^(index\.php)?$ /projekte.html#open-mic-band [R=301,NE,QSD,L]
RewriteCond %{QUERY_STRING} (^|&)p=39(&|$)
RewriteRule ^(index\.php)?$ /projekte.html#emel [R=301,NE,QSD,L]
RewriteCond %{QUERY_STRING} (^|&)p=41(&|$)
RewriteRule ^(index\.php)?$ /projekte.html#andrew-bond [R=301,NE,QSD,L]
RewriteCond %{QUERY_STRING} (^|&)p=43(&|$)
RewriteRule ^(index\.php)?$ /projekte.html#yvonne-moore [R=301,NE,QSD,L]
RewriteCond %{QUERY_STRING} (^|&)p=45(&|$)
