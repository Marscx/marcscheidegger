# Übrige WordPress-Pfade
RewriteRule ^(vergangene-projekte|social-media)/?$ /projekte.html [R=301,L]
RewriteRule ^datenschutzerklaerung/?$ /datenschutz.html [R=301,L]
RewriteRule ^(feed|wp-admin|wp-login\.php|wp-content|wp-json)(/.*)?$ / [R=301,QSD,L]
RewriteCond %{QUERY_STRING} (^|&)(rest_route|feed)=
RewriteRule ^(index\.php)?$ / [R=301,QSD,L]
RewriteRule ^index\.php$ / [R=301,L]
</IfModule>

# Caching: Bilder lange, CSS/JS über ?v=N versioniert
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
