# marcscheidegger.ch – Apache (Plesk)

DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS erzwingen
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Alte WordPress-Adressen (?p=, ?page_id=, ?cat=) auf die neuen Seiten umleiten
RewriteCond %{QUERY_STRING} (^|&)p=33(&|$)
RewriteRule ^(index\.php)?$ /projekte.html#open-mic-band [R=301,NE,QSD,L]
RewriteCond %{QUERY_STRING} (^|&)p=39(&|$)
RewriteRule ^(index\.php)?$ /projekte.html#emel [R=301,NE,QSD,L]
RewriteCond %{QUERY_STRING} (^|&)p=41(&|$)
