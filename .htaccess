# Übrige WordPress-Adressen: alte Seiten, RSS-Feed und Anmeldung → Startseite
RewriteRule ^(vergangene-projekte|social-media)/?$ /projekte.html [R=301,L]
RewriteRule ^datenschutzerklaerung/?$ /datenschutz.html [R=301,L]
RewriteRule ^(feed|wp-admin|wp-login\.php|wp-json)(/.*)?$ / [R=301,QSD,L]

# ---------- 4. Liegengelassenes WordPress stilllegen ----------
# Die WordPress-Dateien bleiben auf dem Server liegen, sollen aber nicht mehr
# ausführbar sein (veraltetes WordPress ist ein Einfallstor für Angreifer).
# Gesperrt (Fehler 403): wp-….php, xmlrpc.php, Versions-Infos (readme, license)
# und alle PHP-Dateien in wp-includes und wp-content.
# Hochgeladene Bilder und PDFs in wp-content/uploads bleiben erreichbar.
RewriteRule ^(wp-[a-z-]+\.php|xmlrpc\.php|readme\.html|liesmich\.html|license\.txt)$ - [F,L]
RewriteRule ^wp-(includes|content)/.*\.php$ - [F,L]
# WordPress-Schnittstellen (?rest_route=, ?feed=) und index.php → Startseite
RewriteCond %{QUERY_STRING} (^|&)(rest_route|feed)=
RewriteRule ^(index\.php)?$ / [R=301,QSD,L]
RewriteRule ^index\.php$ / [R=301,L]
</IfModule>

# ---------- 5. Caching ----------
# Browser dürfen Bilder, CSS und JS ein Jahr lang zwischenspeichern (schnellere Seite).
# Damit Änderungen an CSS/JS trotzdem ankommen, hängt build.py "?v=…" an (Zahl V).
# HTML-Seiten werden immer frisch geladen.
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---------- 6. Test-Subdomain und Sicherheits-Header ----------
# Auf neu.marcscheidegger.ch sendet der Server "noindex": Google nimmt die Testseite
# nicht auf. Auf marcscheidegger.ch selbst greift die Regel nicht.
<IfModule mod_setenvif.c>
SetEnvIfNoCase Host ^neu\. TESTSEITE
</IfModule>

<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow" env=TESTSEITE
# Sicherheits-Header: Dateitypen nicht erraten, beim Verlinken nur die Domain verraten,
# Website nicht in fremde Seiten einbetten lassen
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
